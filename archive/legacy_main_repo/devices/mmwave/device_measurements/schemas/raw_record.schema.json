{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safenest.local/schemas/m-c0/raw-record.schema.json",
  "title": "SafeNest MR60 ESP JSONL Raw Record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "device_id",
    "seq",
    "ts_monotonic_ms",
    "uart_frame_ok",
    "checksum_ok",
    "human_detected_raw",
    "human_detected_stable",
    "distance_cm_raw",
    "breath_rate_raw",
    "breath_rate_filtered",
    "breath_filtered_valid",
    "breath_phase_std",
    "breath_window_ready",
    "heart_rate_raw",
    "heart_raw_valid",
    "heart_verified",
    "total_phase",
    "breath_phase",
    "heart_phase",
    "distance_std_cm",
    "firmware_version",
    "sensor_firmware_version",
    "config_hash",
    "sensor_state",
    "error_code"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "device_id": {"type": "string"},
    "seq": {"type": "integer", "minimum": 0},
    "ts_monotonic_ms": {"type": "integer", "minimum": 0},
    "phase_age_ms": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "Optional producer freshness evidence. Historical records may omit it; without it, fresh phase cadence remains unverified."
    },
    "uart_frame_ok": {"type": "boolean"},
    "checksum_ok": {"type": "boolean"},
    "human_detected_raw": {"type": ["boolean", "null"]},
    "human_detected_stable": {"type": ["boolean", "null"]},
    "distance_cm_raw": {"type": ["number", "null"]},
    "breath_rate_raw": {"type": ["number", "null"]},
    "breath_rate_filtered": {"type": ["number", "null"]},
    "breath_filtered_valid": {"type": ["boolean", "null"]},
    "breath_phase_std": {"type": ["number", "null"]},
    "breath_window_ready": {"type": ["boolean", "null"]},
    "heart_rate_raw": {"type": ["number", "null"]},
    "heart_raw_valid": {"type": ["boolean", "null"]},
    "heart_verified": {"type": ["boolean", "null"]},
    "total_phase": {"type": ["number", "null"]},
    "breath_phase": {"type": ["number", "null"]},
    "heart_phase": {"type": ["number", "null"]},
    "distance_std_cm": {"type": ["number", "null"]},
    "firmware_version": {"type": ["string", "null"]},
    "sensor_firmware_version": {"type": ["string", "null"]},
    "config_hash": {"type": ["string", "null"]},
    "sensor_state": {"type": ["string", "null"]},
    "error_code": {"type": ["string", "number", "null"]}
  }
}
