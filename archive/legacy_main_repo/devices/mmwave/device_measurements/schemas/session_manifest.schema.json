{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safenest.local/schemas/m-c0/session-manifest.schema.json",
  "title": "SafeNest M-C0 Session Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "session_id",
    "subject_id",
    "operator_id",
    "start_time_utc",
    "end_time_utc",
    "sensor",
    "setup",
    "condition",
    "reference",
    "files",
    "privacy",
    "qa"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "m-c0-session-1.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "pilot",
        "formal",
        "completed",
        "aborted"
      ]
    },
    "session_id": {
      "type": "string",
      "pattern": "^M-C0-[A-Z0-9][A-Z0-9_-]*$"
    },
    "subject_id": {
      "type": "string",
      "pattern": "^SUBJ-[A-Z0-9][A-Z0-9_-]*$"
    },
    "operator_id": {
      "type": "string",
      "pattern": "^OP-[A-Z0-9][A-Z0-9_-]*$"
    },
    "start_time_utc": {
      "type": "string",
      "format": "date-time"
    },
    "end_time_utc": {
      "type": "string",
      "format": "date-time"
    },
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "transport",
        "firmware_version",
        "sensor_firmware_version",
        "config_hash"
      ],
      "properties": {
        "model": {
          "type": "string",
          "const": "MR60BHA2"
        },
        "transport": {
          "type": "string",
          "const": "ESP32_UART_USB"
        },
        "firmware_version": {
          "type": "string"
        },
        "sensor_firmware_version": {
          "type": "string"
        },
        "config_hash": {
          "type": "string"
        },
        "device_id": {
          "type": "string"
        }
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distance_cm",
        "sensor_height_cm",
        "sensor_angle_deg",
        "orientation",
        "posture",
        "environment",
        "other_people_present"
      ],
      "properties": {
        "distance_cm": {
          "type": "number",
          "minimum": 0
        },
        "sensor_height_cm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Absolute floor height in cm; null only when an explicitly documented Pilot limitation prevents measurement."
        },
        "sensor_angle_deg": {
          "type": "number"
        },
        "orientation": {
          "type": "string"
        },
        "posture": {
          "type": "string"
        },
        "clothing": {
          "type": "string"
        },
        "bedding": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "other_people_present": {
          "type": "boolean"
        },
        "other_people_distance_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "background_movement": {
          "type": "string"
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "breathing_mode",
        "movement_context"
      ],
      "properties": {
        "breathing_mode": {
          "type": "string",
          "enum": [
            "normal_spontaneous",
            "safe_observation"
          ]
        },
        "movement_context": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "condition_intent": {
          "type": "string",
          "description": "Operator intent for this recording. INTENT IS NOT A LABEL: M-N10 sets intent_is_not_label=true, so this value must never be mapped to a class."
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "independent",
        "synchronized",
        "status"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "none",
            "respiration_belt",
            "manual_count",
            "other"
          ]
        },
        "independent": {
          "type": "boolean"
        },
        "synchronized": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "not_collected",
            "planned",
            "available",
            "invalid"
          ]
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        },
        "actual_reference_availability": {
          "type": "string",
          "enum": [
            "NOT_AVAILABLE",
            "AVAILABLE_ALIGNMENT_VERIFIED",
            "AVAILABLE_ALIGNMENT_UNVERIFIED",
            "NOT_APPLICABLE"
          ],
          "description": "M-N10 session_identity_required field. AVAILABLE_ALIGNMENT_UNVERIFIED maps to the protocol class REFERENCE_ALIGNMENT_UNVERIFIED and is excluded from M-N11 scoring."
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_jsonl",
        "raw_immutable"
      ],
      "properties": {
        "raw_immutable": {
          "type": "boolean",
          "const": true
        },
        "raw_jsonl": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              "record_count": {
                "type": "integer",
                "minimum": 0
              },
              "byte_count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifiers_removed",
        "video_collected",
        "third_party_visible"
      ],
      "properties": {
        "identifiers_removed": {
          "type": "boolean",
          "const": true
        },
        "video_collected": {
          "type": "boolean",
          "const": false
        },
        "third_party_visible": {
          "type": "boolean"
        },
        "consent_or_workplace_permission": {
          "type": "string"
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "pass",
            "pass_with_limitations",
            "fail",
            "unknown"
          ]
        },
        "validator_version": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "trial_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^T[0-9][A-Z0-9_-]*$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Trial within a session. Optional; M-N10 session_identity_required lists it."
    },
    "boot_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Producer boot epoch this session belongs to. The firmware does not emit a boot identifier, so it is DERIVED at capture time: a ts_monotonic_ms that runs backwards relative to the previous capture marks a new boot. M-N4 forbids a window crossing a boot, so sessions from different boots must not be concatenated."
    }
  }
}
